{
  "name": "laras",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @laras/desktop tauri dev",
    "lint": "biome check . && node scripts/lint-tokens.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "render:demo": "tsx --tsconfig tsconfig.base.json scripts/render-demo.ts",
    "render:prototype": "tsx --tsconfig tsconfig.base.json scripts/render-prototype.ts",
    "spike": "tsx --tsconfig tsconfig.base.json scripts/spike/run.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}

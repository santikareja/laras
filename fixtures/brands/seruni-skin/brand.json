{
  "colors": {
    "primary": "#233D63",
    "secondary": "#EAF1F4",
    "accent": "#EA9A84",
    "neutral": { "50": "#F8FAFB", "900": "#121A24" }
  },
  "typography": {
    "heading": {
      "family": "Cormorant Garamond",
      "file": "fonts/cormorant-garamond-latin-wght-normal.woff2",
      "weights": [600]
    },
    "body": {
      "family": "Manrope",
      "file": "fonts/manrope-latin-wght-normal.woff2",
      "weights": [400, 600]
    },
    "accent": {
      "family": "IBM Plex Mono",
      "file": "fonts/ibm-plex-mono-latin-500-normal.woff2",
      "weights": [500]
    },
    "scale": [24, 30, 40, 56, 76, 104]
  },
  "shape": { "radius": 24, "stroke": 1, "shadow": "soft" },
  "spacing": { "unit": 8, "safeMargin": 80 },
  "logo": { "primary": "logo/primary.svg", "onDark": "logo/on-dark.svg" },
  "rules": [
    "Tidak ada klaim medis berlebihan seperti menyembuhkan atau hasil permanen",
    "Banyak ruang kosong"
  ],
  "constraints": {
    "maxMainVisuals": 2,
    "photo": { "realSkin": true }
  },
  "devices": {
    "highlight": { "background": "accent", "color": "neutral-dark", "tilt": 0 },
    "sticker": { "rotate": 0 },
    "scribbles": [],
    "tape": false
  }
}

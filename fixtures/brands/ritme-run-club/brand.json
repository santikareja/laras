{
  "colors": {
    "primary": "#2B4BFF",
    "secondary": "#FFE14D",
    "accent": "#FF4D2E",
    "neutral": { "50": "#FAFAF5", "900": "#14141A" }
  },
  "typography": {
    "heading": {
      "family": "Anton",
      "file": "fonts/anton-latin-400-normal.woff2",
      "weights": [400]
    },
    "body": {
      "family": "Archivo",
      "file": "fonts/archivo-latin-wght-normal.woff2",
      "weights": [400, 600]
    },
    "accent": {
      "family": "Space Mono",
      "file": "fonts/space-mono-latin-700-normal.woff2",
      "weights": [700]
    },
    "scale": [24, 36, 52, 76, 112, 160]
  },
  "shape": { "radius": 0, "stroke": 4, "shadow": "none" },
  "spacing": { "unit": 8, "safeMargin": 64 },
  "logo": { "primary": "logo/primary.svg", "onDark": "logo/on-dark.svg" },
  "rules": [
    "Angka, jarak, dan waktu selalu ditulis besar",
    "Foto selalu menampilkan gerak, bukan pose diam",
    "Warna aksen tidak dipakai sebagai teks di atas warna primer (kontras 1.8:1)"
  ]
}

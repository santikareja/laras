  --space-3: 24px;
  --space-4: 32px;
  --space-5: 48px;
  --space-6: 64px;
  --space-7: 96px;
  --space-8: 128px;
  --space-safe: 64px;
  --shape-radius: 0px;
  --shape-stroke: 2px;
  --shape-shadow: none;
}"
`;


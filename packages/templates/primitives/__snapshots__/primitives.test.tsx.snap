// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`primitives > Badge 1`] = `"<span data-slot="promo" data-slot-type="badge" style="display:block;width:fit-content;padding:var(--space-1) var(--space-2);border-radius:var(--shape-radius);background:var(--color-accent);font-family:var(--font-body);font-weight:var(--font-body-weight-strong);font-size:var(--font-size-1);font-synthesis:none;line-height:1.2;white-space:nowrap;color:var(--color-neutral-dark)">-20%</span>"`;

exports[`primitives > Display: kelipatan skala brand dibatasi lebar kotak 1`] = `"<div style="container-type:inline-size;width:100%"><p data-slot="kata" data-slot-type="text" style="margin:0;font-family:var(--font-heading);font-weight:var(--font-heading-weight-strong);font-size:min(calc(var(--font-size-6, var(--font-size-5, var(--font-size-4, var(--font-size-3, var(--font-size-2, var(--font-size-1)))))) * 2.5), calc(100cqw / 4.90));font-synthesis:none;line-height:0.9;white-space:nowrap;text-align:center;color:var(--color-accent)">SANGRAI</p></div>"`;

exports[`primitives > Grid 1`] = `"<div style="display:grid;grid-template-columns:repeat(6, minmax(0, 1fr));grid-template-rows:1fr auto;gap:var(--space-4);box-sizing:border-box;width:100%;height:100%;padding:var(--space-safe);background:var(--color-neutral-light)"><span>isi</span></div>"`;

exports[`primitives > Image 1`] = `"<link rel="preload" as="image" href="file:///job/assets/hero.png"/><img data-slot="hero" data-slot-type="image" src="file:///job/assets/hero.png" alt="" style="display:block;width:100%;height:100%;object-fit:contain;border-radius:var(--shape-radius)"/>"`;

exports[`primitives > Logo 1`] = `"<link rel="preload" as="image" href="file:///p/logo/primary.svg"/><img data-slot="logo" data-slot-type="logo" src="file:///p/logo/primary.svg" alt="" style="display:block;height:var(--space-6);width:auto"/>"`;

exports[`primitives > Sticker, Scribble, dan Frame 1`] = `"<span data-slot="stiker" data-slot-type="badge" style="display:block;width:fit-content;padding:var(--space-2) var(--space-3);border-radius:var(--shape-radius);border:var(--space-1) solid var(--color-neutral-light);box-shadow:var(--shape-shadow);background:var(--color-primary);font-family:var(--font-body);font-weight:var(--font-body-weight-strong);font-size:var(--font-size-2, var(--font-size-1));font-synthesis:none;line-height:1.1;white-space:nowrap;color:var(--color-neutral-light);transform:rotate(-6deg)">5:45 AM</span>"`;

exports[`primitives > Sticker, Scribble, dan Frame 2`] = `"<svg viewBox="0 40 200 44" aria-hidden="true" style="display:block;width:100%;height:auto;overflow:visible;color:var(--color-accent);transform:rotate(4deg) scaleX(-1)"><path d="M6 58 C 52 46, 124 70, 194 50" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"></path><path d="M18 74 C 70 62, 128 80, 182 66" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"></path></svg>"`;

exports[`primitives > Sticker, Scribble, dan Frame 3`] = `"<link rel="preload" as="image" href="a.png"/><div style="position:relative;box-sizing:border-box;width:100%;height:100%;padding:var(--space-2);background:var(--color-neutral-light);box-shadow:var(--shape-shadow);isolation:isolate;transform:rotate(-4deg)"><img data-slot="image" data-slot-type="image" src="a.png" alt="" style="display:block;width:100%;height:100%;object-fit:cover"/></div>"`;

exports[`primitives > Text body tebal sebagai elemen pilihan 1`] = `"<span style="margin:0;font-family:var(--font-body);font-weight:var(--font-body-weight-strong);font-size:var(--font-size-1);font-synthesis:none;line-height:1.4;text-wrap:pretty;color:var(--color-neutral-dark)">Buka 07.00</span>"`;

exports[`primitives > Text dengan sorot: tanda baca sesudahnya tidak terpisah baris 1`] = `"<h2 data-slot="headline" data-slot-type="text" style="margin:0;font-family:var(--font-heading);font-weight:var(--font-heading-weight);font-size:var(--font-size-6, var(--font-size-5, var(--font-size-4, var(--font-size-3, var(--font-size-2, var(--font-size-1))))));font-synthesis:none;line-height:1.1;text-wrap:balance;color:var(--color-primary)">Disangrai <span style="white-space:nowrap"><span style="display:inline-block;padding:0 0.15em;background:var(--color-accent);color:var(--color-neutral-dark);transform:rotate(-2deg)">minggu ini</span>,</span> bukan bulan lalu.</h2>"`;

exports[`primitives > Text heading 1`] = `"<h2 data-slot="headline" data-slot-type="text" style="margin:0;font-family:var(--font-heading);font-weight:var(--font-heading-weight);font-size:var(--font-size-6, var(--font-size-5, var(--font-size-4, var(--font-size-3, var(--font-size-2, var(--font-size-1))))));font-synthesis:none;line-height:1.1;text-wrap:balance;color:var(--color-primary)">Kopi pagi</h2>"`;

// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`primitives > Badge 1`] = `"<span data-slot="promo" data-slot-type="badge" style="display:block;width:fit-content;padding:var(--space-1) var(--space-2);border-radius:var(--shape-radius);background:var(--color-accent);font-family:var(--font-body);font-weight:var(--font-body-weight-strong);font-size:var(--font-size-1);font-synthesis:none;line-height:1.2;white-space:nowrap;color:var(--color-neutral-dark)">-20%</span>"`;

exports[`primitives > Grid 1`] = `"<div style="display:grid;grid-template-columns:repeat(6, minmax(0, 1fr));grid-template-rows:1fr auto;gap:var(--space-4);box-sizing:border-box;width:100%;height:100%;padding:var(--space-safe);background:var(--color-neutral-light)"><span>isi</span></div>"`;

exports[`primitives > Image 1`] = `"<link rel="preload" as="image" href="file:///job/assets/hero.png"/><img data-slot="hero" data-slot-type="image" src="file:///job/assets/hero.png" alt="" style="display:block;width:100%;height:100%;object-fit:contain;border-radius:var(--shape-radius)"/>"`;

exports[`primitives > Logo 1`] = `"<link rel="preload" as="image" href="file:///p/logo/primary.svg"/><img data-slot="logo" data-slot-type="logo" src="file:///p/logo/primary.svg" alt="" style="display:block;height:var(--space-6);width:auto"/>"`;

exports[`primitives > Text body tebal sebagai elemen pilihan 1`] = `"<span style="margin:0;font-family:var(--font-body);font-weight:var(--font-body-weight-strong);font-size:var(--font-size-1);font-synthesis:none;line-height:1.4;text-wrap:pretty;color:var(--color-neutral-dark)">Buka 07.00</span>"`;

exports[`primitives > Text heading 1`] = `"<h2 data-slot="headline" data-slot-type="text" style="margin:0;font-family:var(--font-heading);font-weight:var(--font-heading-weight);font-size:var(--font-size-6, var(--font-size-5, var(--font-size-4, var(--font-size-3, var(--font-size-2, var(--font-size-1))))));font-synthesis:none;line-height:1.1;text-wrap:balance;color:var(--color-primary)">Kopi pagi</h2>"`;
